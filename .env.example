# URL Flask API для десктоп-приложения
# На Mac порт 5000 часто занят AirPlay — тогда: flask --app app run --port 5001
SPORTORG_API_URL=http://127.0.0.1:5000

# PostgreSQL — Tailscale (ноут MSI), стабильное имя вместо IP
SPORTORG_DB_HOST=msi.tail14031c.ts.net
SPORTORG_DB_PORT=5500
SPORTORG_DB_NAME=postgres
SPORTORG_DB_USER=postgres
SPORTORG_DB_PASSWORD=12345678

# Локальная сеть (без Tailscale):
# SPORTORG_DB_HOST=192.168.1.80

# Альтернатива одной строкой:
# DATABASE_URL=postgresql://postgres:12345678@msi.tail14031c.ts.net:5500/postgres
